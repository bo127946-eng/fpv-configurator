# Quadcopter Low-Poly Clean Model (.obj)
# Center Body (Cube)
v -0.3000 0.0800 -0.3000
v  0.3000 0.0800 -0.3000
v  0.3000 0.0800  0.3000
v -0.3000 0.0800  0.3000
v -0.3000 -0.0800 -0.3000
v  0.3000 -0.0800 -0.3000
v  0.3000 -0.0800  0.3000
v -0.3000 -0.0800  0.3000

# Motor Mounts / Arms Ends (X-configuration)
v -0.9000 0.1000 -0.9000  # 1: Front-Left Motor
v  0.9000 0.1000 -0.9000  # 2: Front-Right Motor
v  0.9000 0.1000  0.9000  # 3: Back-Right Motor
v -0.9000 0.1000  0.9000  # 4: Back-Left Motor

# Normal definitions for smooth rendering
vn  0.0000  1.0000  0.0000
vn  0.0000 -1.0000  0.0000
vn -1.0000  0.0000  0.0000
vn  1.0000  0.0000  0.0000
vn  0.0000  0.0000 -1.0000
vn  0.0000  0.0000  1.0000

# Faces (Body Box)
f 1//1 2//1 3//1 4//1
f 8//2 7//2 6//2 5//2
f 1//3 5//3 8//3 4//3
f 2//4 6//4 7//4 3//4
f 1//5 5//5 6//5 2//5
f 4//6 8//6 7//6 3//6

# Arms connecting body to motors
f 2//1 9//1 6//1
f 3//1 10//1 7//1
f 4//1 11//1 8//1
f 1//1 12//1 5//1
